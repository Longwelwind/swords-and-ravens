<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-agot_bg_website-cc3c780e-67a2-4ac6-99f7-aac7d7619723</UserSecretsId>
    <RootNamespace>agot_bg_website</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.0.106.1" />
    <PackageReference Include="CoreAdmin" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.12" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.1-preview.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.12.0" />
    <PackageReference Include="Soenneker.Validators.Email.Disposable.Online" Version="4.0.5579" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\agot-bg-website.Data\agot-bg-website.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="agot-bg-website.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GameClientTemplates/play.html is placed here by build_and_place_game_client_into_dotnet's
      script (repo root) — see MIGRATION_PLAN.md §8.2. play_fake.html always ships so `dotnet run`
      alone still serves a usable (if game-less) /play page, same as Django's play_fake.html.
    -->
    <Content Include="GameClientTemplates\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
