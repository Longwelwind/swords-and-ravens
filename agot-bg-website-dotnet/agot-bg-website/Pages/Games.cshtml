@page
@model GamesModel
@using agot_bg_website.Pages.Shared
@{
    ViewData["Title"] = "All Games";
}

@{
    var noGamesAtAll = Model.OpenGames.Count == 0 && Model.OngoingGames.Count == 0;
}

<div class="flex items-center justify-between mb-6 gap-3">
    <h1 class="text-2xl font-bold">All Games</h1>
    <div class="flex items-center gap-2">
        <a class="btn btn-sm" style="background-color:#5865F2; color:#fff; border-color:#5865F2;" href="https://discord.gg/6NhRrtV" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-discord" aria-hidden="true"></i>
            Join us on Discord
        </a>
        <a class="btn btn-sm" style="background-color:#29abe0; color:#fff; border-color:#29abe0;" href="https://ko-fi.com/gereon77" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z" />
            </svg>
            Support S&amp;R on Ko-fi
        </a>
        @if (Model.CanCreateGame)
        {
            <button type="button" id="toggle-create-game" class="btn btn-circle btn-primary" title="Create a new game" aria-expanded="@(noGamesAtAll ? "true" : "false")" aria-controls="create-game-panel">
                <span class="text-xl leading-none">+</span>
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error mb-4">@Model.ErrorMessage</div>
}

@await Html.PartialAsync("_ChatWidget", new agot_bg_website.Pages.Shared.ChatWidgetModel(
    agot_bg_website.Infrastructure.Chat.RoomSeeder.PublicRoomId,
    agot_bg_website.Infrastructure.Chat.RoomSeeder.IssuesRoomId,
    User.Identity?.IsAuthenticated ?? false,
    Model.LastFinishedGame))

@if (Model.CanCreateGame)
{
    <div id="create-game-panel" class="card bg-base-200 shadow-md border border-base-300 p-6 mb-8 @(noGamesAtAll ? "" : "hidden")">
        <h2 class="text-lg font-semibold mb-3">Create a new game</h2>
        <form method="post" asp-page-handler="CreateGame" class="flex flex-col sm:flex-row sm:items-center gap-3">
            <input type="text" name="name" class="input flex-1" placeholder="Enter game name..." maxlength="200" required />
            <button type="submit" class="btn btn-primary w-full sm:w-auto px-8">Create Game</button>
        </form>
    </div>
    <script nonce="@HttpContext.GetCspNonce()">
        document.getElementById('toggle-create-game')?.addEventListener('click', () => {
            const panel = document.getElementById('create-game-panel');
            const btn = document.getElementById('toggle-create-game');
            const isHidden = panel.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', (!isHidden).toString());
            if (!isHidden) {
                panel.querySelector('input[name="name"]')?.focus();
            }
        });
    </script>
}

<div class="flex flex-col gap-4">
    @if (Model.CurrentLiveGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-current-live"@(Model.Request.IsCollapseSectionOpen("games-current-live", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold">
                Current live games <span class="badge badge-lg align-middle ml-1">@Model.CurrentLiveGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.CurrentLiveGames,
                    ShowStateBadge = true,
                    ShowJoinAsOwner = true,
                    CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true,
                    EmptyMessage = "No live games right now."
                })
            </div>
        </details>
    }

    <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-your-games"@(Model.Request.IsCollapseSectionOpen("games-your-games", true) ? " open" : "")>
        <summary class="collapse-title text-xl font-semibold">
            <a asp-page="/MyGames" class="link link-hover" title="Go to My Games">Your games</a> <span class="badge badge-lg align-middle ml-1">@Model.MyGames.Count</span>
        </summary>
        <div class="collapse-content">
            @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
            {
                Games = Model.MyGames,
                ShowStateBadge = true,
                CanCancelGame = Model.CanCancelGame,
                IsAuthenticated = true,
                EmptyMessage = "You are not currently part of any game."
            })
        </div>
    </details>

    <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-open"@(Model.Request.IsCollapseSectionOpen("games-open", true) ? " open" : "")>
        <summary class="collapse-title text-xl font-semibold">
            Open games <span class="badge badge-lg align-middle ml-1">@Model.OpenGames.Count</span>
        </summary>
        <div class="collapse-content">
            @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
            {
                Games = Model.OpenGames,
                ShowStateBadge = false,
                ShowJoinAsOwner = true,
                CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                CanCancelGame = Model.CanCancelGame,
                IsAuthenticated = true,
                EmptyMessage = "No open games right now."
            })
        </div>
    </details>

    <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-ongoing"@(Model.Request.IsCollapseSectionOpen("games-ongoing", true) ? " open" : "")>
        <summary class="collapse-title text-xl font-semibold">
            Ongoing games <span class="badge badge-warning badge-lg align-middle ml-1">@Model.OngoingGames.Count</span>
        </summary>
        <div class="collapse-content">
            @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
            {
                Games = Model.OngoingGames,
                ShowStateBadge = false,
                CanCancelGame = Model.CanCancelGame,
                IsAuthenticated = true,
                EmptyMessage = "No ongoing games right now."
            })
        </div>
    </details>

    @if (Model.ReplacementNeededGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-replacement-needed"@(Model.Request.IsCollapseSectionOpen("games-replacement-needed", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold" title="Games where the last move was more than 2 days ago and the player being waited on has not logged in for 8 days.">
                Games waiting for inactive players <span class="badge badge-error badge-lg align-middle ml-1">@Model.ReplacementNeededGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.ReplacementNeededGames,
                    ShowStateBadge = false,
                    ShowJoinAsWaited = true,
                    CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true
                })
            </div>
        </details>
    }

    @if (Model.CanPlayAsAnotherPlayer && Model.InactiveGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-inactive"@(Model.Request.IsCollapseSectionOpen("games-inactive", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold">
                Games without a move for 5 days <span class="badge badge-lg align-middle ml-1">@Model.InactiveGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.InactiveGames,
                    ShowStateBadge = false,
                    ShowJoinAsWaited = true,
                    CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true
                })
            </div>
        </details>
    }

    @if (Model.CanPlayAsAnotherPlayer && Model.InactiveTournamentGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-inactive-tournament"@(Model.Request.IsCollapseSectionOpen("games-inactive-tournament", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold">
                Tournament games without a move for 2 days <span class="badge badge-lg align-middle ml-1">@Model.InactiveTournamentGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.InactiveTournamentGames,
                    ShowStateBadge = false,
                    ShowJoinAsWaited = true,
                    CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true
                })
            </div>
        </details>
    }

    @if (Model.CanCancelGame && Model.InactivePrivateGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-inactive-private"@(Model.Request.IsCollapseSectionOpen("games-inactive-private", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold">
                Inactive private games <span class="badge badge-lg align-middle ml-1">@Model.InactivePrivateGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.InactivePrivateGames,
                    ShowStateBadge = false,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true
                })
            </div>
        </details>
    }
</div>
