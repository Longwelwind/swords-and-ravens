@page "{id:guid}"
@model UserModel
@using agot_bg_website.Domain
@using agot_bg_website.Services.Statistics
@{
    ViewData["Title"] = Model.ViewedUser.DisplayName;
    ViewData["WideContainer"] = true;
}

<div class="mb-6">
    <h1 class="text-2xl font-bold flex items-center gap-2 flex-wrap">
        @foreach (var (name, badgeClass) in Model.UserGroups)
        {
            <span class="badge @badgeClass badge-lg">@name</span>
        }
        <span>@Model.ViewedUser.DisplayName</span>
        @if (!string.IsNullOrEmpty(Model.ViewedUser.LastWonTournament))
        {
            <span class="tooltip tooltip-bottom text-warning" data-tip="Winner of @Model.ViewedUser.LastWonTournament">🏆</span>
        }
        @if (!string.IsNullOrEmpty(Model.ViewedUser.CustomUserBadge))
        {
            <span class="badge badge-neutral badge-lg">@Model.ViewedUser.CustomUserBadge</span>
        }
    </h1>
    @if (!string.IsNullOrEmpty(Model.ViewedUser.ProfileText))
    {
        <p class="mt-2"><b>Personal profile text:</b> @Model.ViewedUser.ProfileText</p>
    }
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <div class="lg:col-span-3">
        <div class="card bg-base-200 shadow-md border border-base-300 p-6">
            <ul class="flex flex-col divide-y divide-base-300">
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Last activity</span>
                    <span class="text-base-content/80 text-right">@Model.RelativeLastActivity</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Joined on</span>
                    <span class="text-base-content/80 text-right">@Model.ViewedUser.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Ongoing games</span>
                    <span class="badge badge-warning badge-lg">@Model.OngoingCount</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Finished games</span>
                    <span class="badge badge-lg">@Model.FinishedCount</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Won games</span>
                    <span class="badge badge-success badge-lg">@Model.WonCount</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Replacer games</span>
                    <span class="badge badge-lg" title="Games joined by seating into an existing house, helping a game that would otherwise have stalled continue.">@Model.ReplacerGamesCount</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5 pl-4 text-sm opacity-80">
                    <span>&#8627; Replacer wins</span>
                    <span class="badge badge-success badge-sm" title="Already included in Won games above.">@Model.ReplacerWinsCount</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5 pl-4 text-sm opacity-80">
                    <span>&#8627; Replacer losses (excluded)</span>
                    <span class="badge badge-ghost badge-sm" title="Excluded entirely from Win rate below - jumping in to help never hurts your win rate.">@Model.ReplacerLossesExcludedCount</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Replaced / left&nbsp;early</span>
                    <span class="badge badge-error badge-lg">@Model.RemovedFromGameCount</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Win rate</span>
                    <span class="badge badge-info badge-lg">@Model.WinRateDisplay</span>
                </li>
                <li class="flex items-center justify-between gap-3 py-2.5">
                    <span class="font-semibold">Average PBEM<br />response time</span>
                    <span class="text-base-content/80 text-right">@Model.AveragePbemResponseTimeDisplay</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="lg:col-span-9 flex flex-col gap-4">
        @if (Model.HouseSelections.Count > 0)
        {
            <section class="card bg-base-200 shadow-md border border-base-300 p-4 sm:p-6" aria-labelledby="house-stats-heading">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h2 id="house-stats-heading" class="text-lg font-semibold">Houses</h2>
                    <select id="house-stats-select" class="select" aria-label="Scenario" style="max-width: 100%;">
                        @foreach (var selection in Model.HouseSelections)
                        {
                            <option value="@selection.Key">@selection.Label</option>
                        }
                    </select>
                </div>
                <p class="text-sm opacity-70 mt-1 mb-1">Win rate &middot; qualifying finished games &middot; the best house needs @PlayerHouseStatsView.MinGamesForBest+ games</p>
                <p class="text-xs opacity-70 mb-4">Only games with a recorded result count here. Tutorial games and losses as a pure replacer are excluded, so this total can be lower than Finished games in your profile.</p>
                @foreach (var selection in Model.HouseSelections)
                {
                    <div class="js-house-panel" data-scenario="@selection.Key" hidden="@(selection.Key.Length > 0)">
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: 0.75rem;">
                            @foreach (var house in selection.Cards)
                            {
                                var played = house.State == HouseCardState.Played;
                                var winRatePercent = house.WinRate is { } rate ? rate * 100 : 0;
                                var summary = house.State switch
                                {
                                    HouseCardState.Played => $"{house.Wins} won of {house.Games}, win rate {house.WinRateDisplay}",
                                    HouseCardState.NotPlayed => "not played",
                                    _ => "not in this scenario",
                                };
                                <div class="rounded-box border border-base-300 bg-base-100 p-3 text-center"
                                     role="group" aria-label="@house.Name: @summary@(house.IsBest ? ", best house" : "")"
                                     style="@(played ? "" : "opacity: 0.5;")@(house.IsBest ? "border-color: #d4af37; box-shadow: 0 0 0 1px #d4af37;" : "")">
                                    <div style="position: relative; width: 5.5rem; height: 5.5rem; margin: 0 auto;">
                                        <svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true" focusable="false" style="transform: rotate(-90deg);">
                                            <circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-opacity="0.15" stroke-width="7" />
                                            @if (played && winRatePercent > 0)
                                            {
                                                <circle cx="50" cy="50" r="44" fill="none" stroke="@house.Color" stroke-width="7" stroke-linecap="round"
                                                        pathLength="100" stroke-dasharray="@winRatePercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) 100" />
                                            }
                                        </svg>
                                        <img src="~/house_icons/@(house.Id).png" alt="" aria-hidden="true"
                                             style="position: absolute; inset: 0; margin: auto; height: 2.75rem; width: auto; max-width: 3.25rem; @(played ? "" : "filter: grayscale(1);")" />
                                    </div>
                                    <div class="font-semibold mt-1" style="@(house.IsBest ? "color: #d4af37;" : "")">
                                        @house.Name@(house.IsBest ? " ★" : "")
                                    </div>
                                    @if (played)
                                    {
                                        <div class="text-xs opacity-70">@house.Wins won of @house.Games</div>
                                    }
                                    else
                                    {
                                        <div class="text-xs opacity-70">@(house.State == HouseCardState.NotPlayed ? "not played" : "not in this scenario")</div>
                                    }
                                    <div class="text-lg font-bold" style="@(house.IsBest ? "color: #d4af37;" : "")">@house.WinRateDisplay</div>
                                </div>
                            }
                        </div>
                        @if (selection.RemovedGames > 0)
                        {
                            <p class="text-xs opacity-70 mt-3">
                                Not included: replaced or left early in @selection.RemovedGames @(selection.RemovedGames == 1 ? "game" : "games") (house not recorded).
                            </p>
                        }
                    </div>
                }
            </section>
        }

        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="user-games"@(Model.Request.IsCollapseSectionOpen("user-games", true) ? " open" : "")>
            <summary class="collapse-title text-lg font-semibold">
                Games <span class="badge badge-lg align-middle ml-1">@Model.GamesOfUser.Count</span>
            </summary>
            <div class="collapse-content">
                @if (Model.GamesOfUser.Count == 0)
                {
                    <p class="opacity-70">No games</p>
                }
                else
                {
                    <div class="overflow-x-auto overflow-y-auto rounded-box border border-base-300 bg-base-100" style="max-height: 1000px;">
                        <table class="table table-zebra table-fixed w-full">
                            <colgroup>
                                <col class="w-24" />
                                <col />
                                <col class="w-20" />
                                <col class="w-28" />
                                @if (Model.CanPlayAsAnotherPlayer)
                                {
                                    <col class="w-28" />
                                }
                            </colgroup>
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Name</th>
                                    <th>Players</th>
                                    <th></th>
                                    @if (Model.CanPlayAsAnotherPlayer)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var game in Model.GamesOfUser)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (game.State == GameState.InLobby)
                                            {
                                                <span class="badge badge-success">Open</span>
                                            }
                                            else if (game.State == GameState.Ongoing)
                                            {
                                                <span class="badge badge-warning">Ongoing</span>
                                            }
                                            else if (game.IsWinner == true)
                                            {
                                                <i class="fa-solid fa-crown text-2xl align-middle" title="Won" aria-label="Won"></i>
                                            }
                                        </td>
                                        <td class="whitespace-normal break-words">
                                            <span class="badge @(game.IsPbem ? "badge-info" : "badge-success") align-middle" title="@(game.IsPbem ? "Play By E-Mail - players receive an e-mail when it is their turn" : "Live game")">
                                                @(game.IsPbem ? "PBEM" : "Live")
                                            </span>
                                            @if (game.IsReplacer)
                                            {
                                                <span class="badge align-middle" title="You joined this game as a replacer, seating into an existing house.">Replacer</span>
                                            }
                                            @if (!string.IsNullOrEmpty(game.House))
                                            {
                                                <span class="house-icon tooltip inline-flex h-6 items-center align-middle" data-tip="@game.House">
                                                    <img src="~/house_icons/@(game.House.ToLowerInvariant()).png" alt="@game.House" class="h-full w-auto shrink-0" />
                                                </span>
                                            }
                                            <a class="link font-semibold text-base text-base-content" href="/play/@game.GameId" target="_blank" rel="noopener noreferrer">@game.Name</a>
                                        </td>
                                        <td class="text-center whitespace-nowrap">
                                            @game.PlayersCount@(game.MaxPlayerCount is not null && game.PlayersCount != game.MaxPlayerCount ? $"/{game.MaxPlayerCount}" : "")
                                        </td>
                                        <td class="whitespace-nowrap">
                                            <button type="button" class="btn btn-ghost btn-sm btn-square js-game-settings-btn" title="View game settings" aria-label="View game settings"
                                                    data-game-name="@game.Name" data-setup-name="@game.SetupName" data-player-count="@game.PlayersCount@(game.MaxPlayerCount is not null && game.PlayersCount != game.MaxPlayerCount ? $"/{game.MaxPlayerCount}" : "")"
                                                    data-owner-name="@game.OwnerDisplayName"
                                                    data-is-faceless="false"
                                                    data-created-at="@game.CreatedAt.ToString("O")"
                                                    data-last-active-at="@(game.State == GameState.InLobby ? null : game.LastActiveAt.ToString("O"))"
                                                    data-round="@(game.State != GameState.InLobby ? (game.Turn?.ToString() ?? "?") : null)"
                                                    data-waiting-for="@game.WaitingFor"
                                                    data-winner="@game.Winner"
                                                    data-settings="@string.Join("|", game.EnabledSettingLabels)">
                                                <i class="fas fa-gear"></i>
                                            </button>
                                        </td>
                                        @if (Model.CanPlayAsAnotherPlayer)
                                        {
                                            <td class="whitespace-nowrap">
                                                <a class="btn btn-outline btn-sm" href="/play/@game.GameId/@Model.ViewedUser.Id" target="_blank" rel="noopener noreferrer">
                                                    Join as
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </details>

        @if (Model.CancelledGames.Count > 0)
        {
            <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="user-cancelled-games"@(Model.Request.IsCollapseSectionOpen("user-cancelled-games", false) ? " open" : "")>
                <summary class="collapse-title text-lg font-semibold">
                    Cancelled games <span class="badge badge-lg align-middle ml-1">@Model.CancelledGames.Count</span>
                </summary>
                <div class="collapse-content">
                    <div class="overflow-x-auto overflow-y-auto rounded-box border border-base-300 bg-base-100" style="max-height: 1000px;">
                        <table class="table table-zebra table-fixed w-full">
                            <colgroup>
                                <col />
                                <col class="w-20" />
                                <col class="w-28" />
                                @if (Model.CanPlayAsAnotherPlayer)
                                {
                                    <col class="w-28" />
                                }
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Players</th>
                                    <th></th>
                                    @if (Model.CanPlayAsAnotherPlayer)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var game in Model.CancelledGames)
                                {
                                    <tr>
                                        <td class="whitespace-normal break-words">
                                            <span class="badge @(game.IsPbem ? "badge-info" : "badge-success") align-middle" title="@(game.IsPbem ? "Play By E-Mail - players receive an e-mail when it is their turn" : "Live game")">
                                                @(game.IsPbem ? "PBEM" : "Live")
                                            </span>
                                            @if (game.IsReplacer)
                                            {
                                                <span class="badge align-middle" title="You joined this game as a replacer, seating into an existing house.">Replacer</span>
                                            }
                                            <a class="link font-semibold text-base text-base-content" href="/play/@game.GameId" target="_blank" rel="noopener noreferrer">@game.Name</a>
                                        </td>
                                        <td class="text-center whitespace-nowrap">@game.PlayersCount</td>
                                        <td class="whitespace-nowrap">
                                            <button type="button" class="btn btn-ghost btn-sm btn-square js-game-settings-btn" title="View game settings" aria-label="View game settings"
                                                    data-game-name="@game.Name" data-setup-name="@game.SetupName" data-player-count="@game.PlayersCount"
                                                    data-owner-name="@game.OwnerDisplayName"
                                                    data-is-faceless="false"
                                                    data-created-at="@game.CreatedAt.ToString("O")"
                                                    data-last-active-at="@game.LastActiveAt.ToString("O")"
                                                    data-round="@(game.Turn?.ToString() ?? "?")"
                                                    data-waiting-for="@game.WaitingFor"
                                                    data-settings="@string.Join("|", game.EnabledSettingLabels)">
                                                <i class="fas fa-gear"></i>
                                            </button>
                                        </td>
                                        @if (Model.CanPlayAsAnotherPlayer)
                                        {
                                            <td class="whitespace-nowrap">
                                                <a class="btn btn-outline btn-sm" href="/play/@game.GameId/@Model.ViewedUser.Id" target="_blank" rel="noopener noreferrer">
                                                    Join as
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </details>
        }

        @if (Model.PreviouslyParticipatedGames.Count > 0)
        {
            <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="user-previous-games"@(Model.Request.IsCollapseSectionOpen("user-previous-games", false) ? " open" : "")>
                <summary class="collapse-title text-lg font-semibold">
                    Previously participated games <span class="badge badge-lg align-middle ml-1">@Model.PreviouslyParticipatedGames.Count</span>
                </summary>
                <div class="collapse-content">
                    <p class="opacity-70 text-sm mb-3">Games you were replaced or removed from before they ended.</p>
                    <div class="overflow-x-auto overflow-y-auto rounded-box border border-base-300 bg-base-100" style="max-height: 1000px;">
                        <table class="table table-zebra table-fixed w-full">
                            <colgroup>
                                <col class="w-24" />
                                <col />
                                <col class="w-20" />
                                <col class="w-32" />
                                <col class="w-28" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Name</th>
                                    <th>Players</th>
                                    <th>Reason</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var game in Model.PreviouslyParticipatedGames)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (game.State == GameState.Cancelled)
                                            {
                                                @if (game.Reason == PlayerReplacementReason.ClockTimeout || game.IsReplacer)
                                                {
                                                    <span class="badge badge-neutral" title="This game was later cancelled - it never counted towards your stats.">Cancelled</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-neutral" title="This game was later cancelled - leaving it early still counts as a loss.">Cancelled</span>
                                                }
                                            }
                                        </td>
                                        <td class="whitespace-normal break-words">
                                            <span class="badge @(game.IsPbem ? "badge-info" : "badge-success") align-middle" title="@(game.IsPbem ? "Play By E-Mail - players receive an e-mail when it is their turn" : "Live game")">
                                                @(game.IsPbem ? "PBEM" : "Live")
                                            </span>
                                            @if (game.IsReplacer)
                                            {
                                                <span class="badge align-middle" title="You had joined this game as a replacer - this removal is excluded from your Removed count and win rate.">Replacer</span>
                                            }
                                            <a class="link font-semibold text-base text-base-content" href="/play/@game.GameId" target="_blank" rel="noopener noreferrer">@game.Name</a>
                                        </td>
                                        <td class="text-center whitespace-nowrap">
                                            @game.PlayersCount@(game.MaxPlayerCount is not null && game.PlayersCount != game.MaxPlayerCount ? $"/{game.MaxPlayerCount}" : "")
                                        </td>
                                        <td class="whitespace-nowrap">
                                            @(game.Reason switch
                                            {
                                                PlayerReplacementReason.Vote => "Voted out",
                                                PlayerReplacementReason.ClockTimeout => "Clock timeout",
                                                _ => "Unknown",
                                            })
                                        </td>
                                        <td class="whitespace-nowrap">
                                            <button type="button" class="btn btn-ghost btn-sm btn-square js-game-settings-btn" title="View game settings" aria-label="View game settings"
                                                    data-game-name="@game.Name" data-setup-name="@game.SetupName" data-player-count="@game.PlayersCount@(game.MaxPlayerCount is not null && game.PlayersCount != game.MaxPlayerCount ? $"/{game.MaxPlayerCount}" : "")"
                                                    data-owner-name="@game.OwnerDisplayName"
                                                    data-is-faceless="@game.IsFaceless"
                                                    data-created-at="@game.CreatedAt.ToString("O")"
                                                    data-last-active-at="@game.LastActiveAt.ToString("O")"
                                                    data-round="@(game.Turn?.ToString() ?? "?")"
                                                    data-waiting-for="@game.WaitingFor"
                                                    data-winner="@game.Winner"
                                                    data-settings="@string.Join("|", game.EnabledSettingLabels)">
                                                <i class="fas fa-gear"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </details>
        }
    </div>
</div>

@if (Model.HouseSelections.Count > 0)
{
    <script nonce="@HttpContext.GetCspNonce()">
        (function () {
            var select = document.getElementById('house-stats-select');
            if (!select) { return; }
            var panels = document.querySelectorAll('.js-house-panel');
            function show() {
                panels.forEach(function (panel) {
                    panel.hidden = panel.getAttribute('data-scenario') !== select.value;
                });
            }
            select.addEventListener('change', show);
            show();
        })();
    </script>
}
