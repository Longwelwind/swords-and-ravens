@model agot_bg_website.Infrastructure.Paging.PagerInfo
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Primitives
@{
    string Href(int page)
    {
        var query = new Dictionary<string, StringValues>(Context.Request.Query, StringComparer.OrdinalIgnoreCase) { ["pageNumber"] = page.ToString() };
        var pairs = query.Select(kv => new KeyValuePair<string, string?>(kv.Key, kv.Value.ToString()));
        return Context.Request.Path + QueryString.Create(pairs);
    }

    // Every other current querystring param (Search, RoomId, ...) needs to be round-tripped as a
    // hidden field on the small forms below, since a plain GET form only submits its own named
    // inputs and would otherwise silently drop them.
    IEnumerable<(string Key, string Value)> HiddenParams(params string[] excludedKeys)
    {
        foreach (var (key, values) in Context.Request.Query)
        {
            if (excludedKeys.Contains(key, StringComparer.OrdinalIgnoreCase))
            {
                continue;
            }

            foreach (var value in values)
            {
                if (value is not null)
                {
                    yield return (key, value);
                }
            }
        }
    }

    // Keyed by path (via PageSizeCookie.KeyFor) so different list pages (Games/Rooms/Messages/
    // Users/...) each remember their own preferred page size independently. Computing the exact
    // cookie name here (rather than duplicating the sanitization logic in JS) guarantees the
    // client-side write and PageSizeCookie.Read's server-side read always agree on it.
    var pageSizeCookieName = agot_bg_website.Infrastructure.Paging.PageSizeCookie.KeyFor(
        Context.Request.Path
    );
}

<div class="flex flex-wrap items-center justify-end gap-4 mt-4 text-sm" data-page-size-widget data-cookie-name="@pageSizeCookieName">
    <form method="get" class="flex items-center gap-2" data-page-size-form>
        @foreach (var (key, value) in HiddenParams("pageSize", "pageNumber"))
        {
            <input type="hidden" name="@key" value="@value" />
        }
        <label for="pageSizeInput" class="opacity-70">Items per page:</label>
        <input type="number" id="pageSizeInput" name="pageSize" min="@agot_bg_website.Infrastructure.Paging.PagingExtensions.MinPageSize" max="@agot_bg_website.Infrastructure.Paging.PagingExtensions.MaxPageSize" value="@Model.PageSize" class="input input-sm w-20" />
        <button type="submit" class="btn btn-sm">Apply</button>
    </form>

    @if (Model.TotalPages > 1)
    {
        <form method="get" class="flex items-center gap-2">
            @foreach (var (key, value) in HiddenParams("pageNumber"))
            {
                <input type="hidden" name="@key" value="@value" />
            }
            <label for="pageNumberInput" class="opacity-70">Go to page:</label>
            <input type="number" id="pageNumberInput" name="pageNumber" min="1" max="@Model.TotalPages" value="@Model.PageNumber" class="input input-sm w-20" />
            <button type="submit" class="btn btn-sm">Go</button>
        </form>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="flex flex-wrap items-center justify-between gap-2 mt-2 text-sm">
        <span class="opacity-70">Page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount.ToString("N0") total)</span>
        <div class="join">
            @if (Model.HasPrevious)
            {
                <a class="join-item btn btn-sm" href="@Href(1)">« First</a>
                <a class="join-item btn btn-sm" href="@Href(Model.PageNumber - 1)">‹ Prev</a>
            }
            else
            {
                <span class="join-item btn btn-sm btn-disabled">« First</span>
                <span class="join-item btn btn-sm btn-disabled">‹ Prev</span>
            }
            <span class="join-item btn btn-sm btn-disabled">@Model.PageNumber / @Model.TotalPages</span>
            @if (Model.HasNext)
            {
                <a class="join-item btn btn-sm" href="@Href(Model.PageNumber + 1)">Next ›</a>
                <a class="join-item btn btn-sm" href="@Href(Model.TotalPages)">Last »</a>
            }
            else
            {
                <span class="join-item btn btn-sm btn-disabled">Next ›</span>
                <span class="join-item btn btn-sm btn-disabled">Last »</span>
            }
        </div>
    </div>
}

<script nonce="@Context.GetCspNonce()">
    // Persists the "Items per page" choice in a cookie (see PageSizeCookie.cs, which computes
    // the exact same cookie name server-side and reads it back on the next visit to bake the
    // saved page size directly into the initial render). An earlier version of this stored the
    // value in localStorage and had to redirect client-side after first paint whenever the
    // rendered default didn't match the stored value - moving it server-side (like
    // CollapseStateExtensions's details-section open/closed state) avoids that redirect/flash
    // entirely.
    (function () {
        document.querySelectorAll('[data-page-size-widget]').forEach(function (widget) {
            var cookieName = widget.dataset.cookieName;
            var form = widget.querySelector('[data-page-size-form]');
            form?.addEventListener('submit', function () {
                var input = form.querySelector('input[name="pageSize"]');
                if (input && cookieName) {
                    var oneYearInSeconds = 60 * 60 * 24 * 365;
                    document.cookie =
                        cookieName + "=" + input.value +
                        "; path=/; max-age=" + oneYearInSeconds + "; samesite=lax";
                }
            });
        });
    })();
</script>
